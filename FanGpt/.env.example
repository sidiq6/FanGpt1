# Server only. Never prefix the Gemini key with NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.5-flash-lite

# Only the URL and publishable/legacy anon key are exposed to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret (or use SUPABASE_SERVICE_ROLE_KEY for a legacy key).
SUPABASE_SECRET_KEY=

# Comma-separated, verified account emails. Set only on the server.
ADMIN_EMAILS=
